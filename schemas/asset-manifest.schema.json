{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FrameLoom Asset Manifest",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "image",
              "screenshot",
              "font",
              "audio",
              "video",
              "other"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "intendedUse": {
            "type": "string",
            "minLength": 1
          },
          "usage": {
            "type": "string",
            "enum": [
              "scene-media",
              "palette-reference",
              "both"
            ]
          }
        },
        "required": [
          "id",
          "path",
          "type",
          "source",
          "license",
          "intendedUse"
        ],
        "additionalProperties": false
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "assets"
  ],
  "additionalProperties": false
}
