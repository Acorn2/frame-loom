{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FrameLoom Asset Manifest",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "image",
              "screenshot",
              "font",
              "audio",
              "video",
              "other"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "intendedUse": {
            "type": "string",
            "minLength": 1
          },
          "usage": {
            "type": "string",
            "enum": [
              "scene-media",
              "palette-reference",
              "both"
            ]
          },
          "generation": {
            "type": "object",
            "properties": {
              "tool": {
                "type": "string",
                "const": "imagegen"
              },
              "style": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "enum": [
                      "whiteboard",
                      "flat-explainer",
                      "paper-collage",
                      "annotated-reasoning",
                      "editorial-typography"
                    ]
                  },
                  "version": {
                    "type": "string",
                    "const": "1.0.0"
                  }
                },
                "required": [
                  "id",
                  "version"
                ],
                "additionalProperties": false
              },
              "planId": {
                "type": "string",
                "minLength": 1
              },
              "planHash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "promptHash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "fileHash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "review": {
                "type": "object",
                "properties": {
                  "reviewer": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reviewedAt": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                  }
                },
                "required": [
                  "reviewer",
                  "reviewedAt"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "tool",
              "style",
              "planId",
              "planHash",
              "promptHash",
              "fileHash",
              "review"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "path",
          "type",
          "source",
          "license",
          "intendedUse"
        ],
        "additionalProperties": false
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "assets"
  ],
  "additionalProperties": false
}
