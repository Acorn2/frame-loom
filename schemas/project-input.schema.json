{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FrameLoom Project Input",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "inputMode": {
      "type": "string",
      "enum": [
        "document",
        "document-images"
      ]
    },
    "colorMode": {
      "type": "string",
      "enum": [
        "auto",
        "style",
        "source"
      ]
    },
    "palettePolicy": {
      "type": "string",
      "const": "source-roles-v1"
    },
    "illustrationPolicy": {
      "type": "string",
      "const": "generated-subjects-v1"
    },
    "colorFallbackReason": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schemaVersion",
    "inputMode"
  ],
  "additionalProperties": false
}
