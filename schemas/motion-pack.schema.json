          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "durationFrames",
        "easing"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "runtime",
    "enter",
    "reveal",
    "highlight",
    "focus",
    "count"
  ],
  "additionalProperties": false
}
