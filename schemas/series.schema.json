{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FrameLoom Series",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "\\S"
    },
    "style": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "version": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "font": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "version": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "brand": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "accent": {
          "type": "string",
          "pattern": "^#[a-fA-F0-9]{6}$"
        },
        "ink": {
          "type": "string",
          "pattern": "^#[a-fA-F0-9]{6}$"
        },
        "logo": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "license": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "path",
            "source",
            "license"
          ],
          "additionalProperties": false
        },
        "watermark": {
          "type": "object",
          "properties": {
            "enabled": {
              "default": true,
              "type": "boolean"
            },
            "position": {
              "default": "top-right",
              "type": "string",
              "const": "top-right"
            },
            "opacity": {
              "default": 0.72,
              "type": "number",
              "minimum": 0.5,
              "maximum": 1
            },
            "size": {
              "default": 36,
              "type": "number",
              "minimum": 24,
              "maximum": 40
            },
            "margin": {
              "default": 56,
              "type": "number",
              "minimum": 40,
              "maximum": 64
            },
            "drawInSeconds": {
              "default": 1.2,
              "type": "number",
              "minimum": 0,
              "maximum": 3
            },
            "sparkle": {
              "default": true,
              "type": "boolean"
            },
            "underline": {
              "default": true,
              "type": "boolean"
            }
          },
          "required": [
            "enabled",
            "position",
            "opacity",
            "size",
            "margin",
            "drawInSeconds",
            "sparkle",
            "underline"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "watermark"
      ],
      "additionalProperties": false
    },
    "drawingGuide": {
      "type": "string",
      "pattern": "\\S"
    },
    "fixedEnding": {
      "type": "string",
      "maxLength": 10000,
      "pattern": "\\S"
    },
    "characters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "path": {
            "type": "string",
            "pattern": "\\S"
          },
          "source": {
            "type": "string",
            "pattern": "\\S"
          },
          "sourceFile": {
            "type": "string",
            "pattern": "\\S"
          },
          "license": {
            "type": "string",
            "pattern": "\\S"
          },
          "intendedUse": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "required": [
          "id",
          "path",
          "source",
          "license",
          "intendedUse"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "version",
    "style",
    "font",
    "brand",
    "drawingGuide",
    "fixedEnding",
    "characters"
  ],
  "additionalProperties": false
}
