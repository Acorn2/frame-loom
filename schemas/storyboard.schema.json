{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FrameLoom Storyboard V2.1–2.2",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": [
        "2.1",
        "2.2"
      ]
    },
    "style": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "project": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "fps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "durationSec": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "durationFrames": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "generated",
            "validated",
            "reviewed",
            "approved"
          ]
        }
      },
      "required": [
        "title",
        "width",
        "height",
        "fps",
        "durationSec",
        "durationFrames",
        "status"
      ],
      "additionalProperties": false
    },
    "scenes": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "template": {
            "type": "string",
            "enum": [
              "statement",
              "graph-explainer",
              "metric-grid",
              "interaction-flow"
            ]
          },
          "purpose": {
            "type": "string",
            "enum": [
              "opening",
              "claim",
              "process",
              "evidence",
              "media",
              "closing"
            ]
          },
          "title": {
            "type": "string"
          },
          "primaryClaim": {
            "type": "string",
            "minLength": 1
          },
          "attentionTarget": {
            "type": "string",
            "minLength": 1
          },
          "narration": {
            "type": "string"
          },
          "durationFrames": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "layers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "node",
                    "card",
                    "label",
                    "annotation",
                    "metric",
                    "screenshot",
                    "object",
                    "callout"
                  ]
                },
                "text": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "value": {
                  "type": [
                    "string",
                    "number"
                  ]
                },
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "width": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "height": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "color": {
                  "type": "string"
                },
                "asset": {
                  "type": "string",
                  "minLength": 1
                },
                "assetDataUri": {
                  "type": "string",
                  "minLength": 1
                },
                "rotate": {
                  "type": "number"
                },
                "rotationDegrees": {
                  "type": "number"
                },
                "semanticRole": {
                  "type": "string",
                  "minLength": 1
                },
                "target": {
                  "type": "string",
                  "minLength": 1
                },
                "fit": {
                  "type": "string",
                  "enum": [
                    "contain",
                    "cover"
                  ]
                },
                "state": {
                  "type": "string",
                  "enum": [
                    "upcoming",
                    "current",
                    "completed",
                    "resolved"
                  ]
                },
                "replacementGroup": {
                  "type": "string",
                  "minLength": 1
                },
                "visibleFrom": {
                  "type": "number",
                  "minimum": 0
                },
                "visibleUntil": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "required": [
                "id",
                "type"
              ],
              "additionalProperties": false
            }
          },
          "connections": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "from": {
                  "type": "string",
                  "minLength": 1
                },
                "to": {
                  "type": "string",
                  "minLength": 1
                },
                "label": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "from",
                "to"
              ],
              "additionalProperties": false
            }
          },
          "beats": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "target": {
                  "type": "string",
                  "minLength": 1
                },
                "action": {
                  "type": "string",
                  "enum": [
                    "enter",
                    "reveal",
                    "draw",
                    "focus",
                    "highlight",
                    "count",
                    "camera-push",
                    "rotate",
                    "set-state"
                  ]
                },
                "state": {
                  "type": "string",
                  "enum": [
                    "upcoming",
                    "current",
                    "completed",
                    "resolved"
                  ]
                },
                "start": {
                  "type": "number",
                  "minimum": 0
                },
                "duration": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "required": [
                "id",
                "target",
                "action",
                "start",
                "duration"
              ],
              "additionalProperties": false
            }
          },
          "captions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "start": {
                  "type": "number",
                  "minimum": 0
                },
                "end": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "required": [
                "id",
                "text",
                "start",
                "end"
              ],
              "additionalProperties": false
            }
          },
          "transitionIn": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "overlap-fade",
                  "overlap-slide",
                  "overlap-carry"
                ]
              },
              "durationFrames": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "type",
              "durationFrames"
            ],
            "additionalProperties": false
          },
          "transitionOut": {
            "type": "string",
            "enum": [
              "fade",
              "slide",
              "paper-wipe",
              "carry"
            ]
          },
          "outro": {
            "type": "object",
            "properties": {
              "holdFrames": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "fadeFrames": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "holdFrames",
              "fadeFrames"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "template",
          "title",
          "narration",
          "durationFrames",
          "layers",
          "connections",
          "beats",
          "captions"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "style",
    "project",
    "scenes"
  ],
  "additionalProperties": false
}
