{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FrameLoom Audio Config",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "voiceover": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "enabled",
        "path",
        "volume",
        "source",
        "license"
      ],
      "additionalProperties": false
    },
    "captions": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "default": "auto",
          "type": "string",
          "enum": [
            "srt",
            "vtt",
            "auto"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "enabled",
        "path",
        "format",
        "source"
      ],
      "additionalProperties": false
    },
    "music": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "fadeInSec": {
          "type": "number",
          "minimum": 0
        },
        "fadeOutSec": {
          "type": "number",
          "minimum": 0
        },
        "ducking": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "volume": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "attackSec": {
              "default": 0.08,
              "type": "number",
              "minimum": 0
            },
            "releaseSec": {
              "default": 0.18,
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "enabled",
            "volume",
            "attackSec",
            "releaseSec"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "enabled",
        "path",
        "volume",
        "source",
        "license"
      ],
      "additionalProperties": false
    },
    "sfx": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "volume": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "startSec": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "enabled",
          "path",
          "volume",
          "source",
          "license"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion"
  ],
  "additionalProperties": false
}
