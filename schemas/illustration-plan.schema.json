{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FrameLoom Illustration Plan",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "style": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "whiteboard",
            "flat-explainer",
            "paper-collage",
            "annotated-reasoning",
            "editorial-typography"
          ]
        },
        "version": {
          "type": "string",
          "const": "1.0.0"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "assets": {
      "maxItems": 24,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "path": {
            "type": "string",
            "pattern": "^assets\\/[a-z0-9]+(?:-[a-z0-9]+)*\\.png$"
          },
          "subject": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "purpose": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "sourceClaim": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "references": {
            "maxItems": 3,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "path",
          "subject",
          "purpose",
          "sourceClaim"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "style",
    "assets"
  ],
  "additionalProperties": false
}
