{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FrameLoom Speech Cue Groups",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "scenes": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sceneId": {
            "type": "string",
            "minLength": 1
          },
          "textHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "groups": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "targets": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": [
                "text",
                "targets"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "sceneId",
          "textHash",
          "groups"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "scenes"
  ],
  "additionalProperties": false
}
