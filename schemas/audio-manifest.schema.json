{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FrameLoom Audio Manifest",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "kind": {
      "type": "string",
      "const": "voiceover"
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "ttsConfigFingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifactFingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "storyboardPath": {
      "type": "string",
      "minLength": 1
    },
    "textSource": {
      "type": "string",
      "const": "scene.narration"
    },
    "segments": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sceneId": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "textHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "startSec": {
            "type": "number",
            "minimum": 0
          },
          "durationSec": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "endSec": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "source": {
            "type": "string",
            "enum": [
              "tts",
              "external"
            ]
          }
        },
        "required": [
          "sceneId",
          "text",
          "textHash",
          "path",
          "startSec",
          "durationSec",
          "endSec",
          "source"
        ],
        "additionalProperties": false
      }
    },
    "fullAudioPath": {
      "type": "string",
      "minLength": 1
    },
    "captionsPath": {
      "type": "string",
      "minLength": 1
    },
    "audioConfigPath": {
      "type": "string",
      "minLength": 1
    },
    "projectDurationSec": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "captionInputFingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "captionTimingSource": {
      "type": "string",
      "enum": [
        "estimated",
        "manual"
      ]
    },
    "notes": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "provider",
    "generatedAt",
    "storyboardPath",
    "textSource",
    "segments",
    "fullAudioPath",
    "captionsPath",
    "audioConfigPath",
    "projectDurationSec",
    "notes"
  ],
  "additionalProperties": false
}
