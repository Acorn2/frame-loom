{
  "id": "paper-collage",
  "version": "1.0.0",
  "tokens": {
    "background": "#ffffff",
    "ink": "#172033",
    "captionInk": "#253044",
    "muted": "#4b5568",
    "accent": "#1688f8",
    "accentAlt": "#de3e49",
    "paper": "#f5f7fa",
    "grid": "#dce2eb",
    "displayFont": "\"PingFang SC\", \"Microsoft YaHei\", sans-serif",
    "bodyFont": "\"PingFang SC\", \"Microsoft YaHei\", sans-serif",
    "pattern": "solid",
    "surfaceRadius": 0,
    "surfaceBorder": "2px solid #dce2eb",
    "surfaceShadow": "none",
    "labelRadius": 0,
    "titleFontSize": 86
  },
  "safeArea": {
    "landscape": {
      "top": 96,
      "right": 110,
      "bottom": 108,
      "left": 110
    },
    "portrait": {
      "top": 128,
      "right": 72,
      "bottom": 144,
      "left": 72
    }
  },
  "supports": {
    "purposes": [
      "opening",
      "claim",
      "process",
      "evidence",
      "media",
      "closing"
    ],
    "templates": [
      "statement",
      "graph-explainer",
      "metric-grid",
      "interaction-flow"
    ],
    "layers": [
      "label",
      "card",
      "annotation",
      "metric",
      "node",
      "screenshot",
      "object",
      "callout"
    ],
    "actions": [
      "enter",
      "reveal",
      "draw",
      "focus",
      "highlight",
      "count",
      "camera-push",
      "rotate",
      "set-state",
      "trace"
    ],
    "transitions": [
      "fade",
      "slide",
      "paper-wipe",
      "carry"
    ],
    "overlapTransitions": [
      "overlap-fade",
      "overlap-slide",
      "overlap-carry"
    ]
  },
  "provenance": {
    "fonts": "System stack for raw samples; explicit fingerprinted storyboard.font overrides all generated text.",
    "assets": "Independent generated subjects registered with prompt, image fingerprints and review; source screenshots are never generated."
  }
}
