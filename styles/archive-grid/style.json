{
  "id": "archive-grid",
  "version": "1.0.0",
  "tokens": {
    "background": "#f6f7fa",
    "ink": "#161b24",
    "captionInk": "#495262",
    "muted": "#495262",
    "accent": "#002fa7",
    "accentAlt": "#002fa7",
    "paper": "#ffffff",
    "grid": "#b8bfcb",
    "displayFont": "Arial, \"PingFang SC\", \"Noto Sans CJK SC\", \"Microsoft YaHei\", sans-serif",
    "bodyFont": "Arial, \"PingFang SC\", \"Noto Sans CJK SC\", \"Microsoft YaHei\", sans-serif",
    "pattern": "solid",
    "surfaceRadius": 0,
    "surfaceBorder": "1px solid #b8bfcb",
    "surfaceShadow": "none",
    "labelRadius": 0,
    "titleFontSize": 104
  },
  "safeArea": {
    "landscape": {
      "top": 100,
      "right": 120,
      "bottom": 100,
      "left": 120
    },
    "portrait": {
      "top": 132,
      "right": 72,
      "bottom": 132,
      "left": 72
    }
  },
  "supports": {
    "purposes": [
      "opening",
      "claim",
      "process",
      "evidence",
      "media",
      "closing"
    ],
    "templates": [
      "statement",
      "graph-explainer",
      "metric-grid",
      "interaction-flow"
    ],
    "layers": [
      "label",
      "card",
      "annotation",
      "metric",
      "node",
      "screenshot",
      "object",
      "callout"
    ],
    "actions": [
      "enter",
      "reveal",
      "draw",
      "focus",
      "highlight",
      "count",
      "camera-push",
      "rotate",
      "set-state"
    ],
    "transitions": [
      "fade",
      "slide",
      "paper-wipe",
      "carry"
    ],
    "overlapTransitions": [
      "overlap-fade",
      "overlap-slide",
      "overlap-carry"
    ]
  },
  "provenance": {
    "fonts": "System Arial / PingFang SC / Microsoft YaHei or installed Noto Sans CJK SC; no fonts bundled.",
    "assets": "CSS-only layout chrome; media is supplied by the storyboard and must be recorded in its asset manifest."
  }
}
