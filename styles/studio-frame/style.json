{
  "id": "studio-frame",
  "version": "1.0.0",
  "tokens": {
    "background": "#eef1f4",
    "ink": "#23302b",
    "captionInk": "#4B5E55",
    "muted": "#4b5e55",
    "accent": "#b5ce45",
    "accentAlt": "#486f28",
    "paper": "#ffffff",
    "grid": "#cdd5d4",
    "displayFont": "Arial, \"PingFang SC\", \"Noto Sans CJK SC\", \"Microsoft YaHei\", sans-serif",
    "bodyFont": "Arial, \"PingFang SC\", \"Noto Sans CJK SC\", \"Microsoft YaHei\", sans-serif",
    "pattern": "desktop",
    "surfaceRadius": 16,
    "surfaceBorder": "1px solid #cdd5d4",
    "surfaceShadow": "0 18px 36px #23302b12",
    "labelRadius": 4,
    "titleFontSize": 110
  },
  "safeArea": {
    "landscape": {
      "top": 90,
      "right": 120,
      "bottom": 105,
      "left": 120
    },
    "portrait": {
      "top": 132,
      "right": 72,
      "bottom": 144,
      "left": 72
    }
  },
  "supports": {
    "purposes": [
      "opening",
      "claim",
      "process",
      "evidence",
      "media",
      "closing"
    ],
    "templates": [
      "statement",
      "graph-explainer",
      "metric-grid",
      "interaction-flow"
    ],
    "layers": [
      "label",
      "card",
      "annotation",
      "metric",
      "node",
      "screenshot",
      "object",
      "callout"
    ],
    "actions": [
      "enter",
      "reveal",
      "draw",
      "focus",
      "highlight",
      "count",
      "camera-push",
      "rotate",
      "set-state"
    ],
    "transitions": [
      "fade",
      "slide",
      "paper-wipe",
      "carry"
    ],
    "overlapTransitions": [
      "overlap-fade",
      "overlap-slide",
      "overlap-carry"
    ]
  },
  "provenance": {
    "fonts": "System Arial / PingFang SC / Microsoft YaHei or installed Noto Sans CJK SC; no fonts bundled.",
    "assets": "CSS-only layout chrome; media is supplied by the storyboard and must be recorded in its asset manifest."
  }
}
