{
  "id": "concept-matrix",
  "version": "1.0.0",
  "status": "experimental",
  "registered": true,
  "visualKinds": [
    "statement"
  ],
  "purpose": "低密度概念矩阵建立",
  "inputModes": [
    "document-only",
    "document-with-assets"
  ],
  "requiredAssets": [],
  "styles": [
    "retro-zine"
  ],
  "orientations": [
    "landscape"
  ],
  "slots": {
    "items": {
      "min": 2,
      "max": 4,
      "labelMax": 14,
      "textMax": 48
    },
    "fronts": {
      "min": 2,
      "max": 4,
      "labelMax": 12,
      "textMax": 40
    }
  },
  "timing": {
    "actions": {
      "enter": {
        "minSec": 0.2,
        "maxSec": 1.2
      },
      "reveal": {
        "minSec": 0.2,
        "maxSec": 1.2
      },
      "draw": {
        "minSec": 0.15,
        "maxSec": 0.8
      },
      "focus": {
        "minSec": 0.15,
        "maxSec": 1.2
      },
      "highlight": {
        "minSec": 0.15,
        "maxSec": 0.6
      },
      "count": {
        "minSec": 0.2,
        "maxSec": 1.2
      }
    },
    "readingSec": 0.8,
    "titleHoldSec": 0.6,
    "sourceHoldSec": 0.3,
    "itemHoldSec": 0.6
  },
  "motion": {
    "recipeOwned": [
      "concept-matrix",
      "bounded-stage-order"
    ],
    "styleOwned": [
      "color",
      "font",
      "surface",
      "entrance-offset"
    ],
    "continuousDrift": false
  },
  "qa": [
    "action-mid",
    "action-complete",
    "complete",
    "before-handoff"
  ],
  "sound": {
    "enabled": false,
    "events": [
      "title-settled",
      "item-entered"
    ]
  }
}
