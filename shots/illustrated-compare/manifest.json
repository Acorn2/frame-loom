{
  "id": "illustrated-compare",
  "version": "1.2.0",
  "status": "experimental",
  "registered": true,
  "visualKinds": [
    "compare"
  ],
  "purpose": "插画对照",
  "inputModes": [
    "document-only",
    "document-with-assets"
  ],
  "requiredAssets": [],
  "styles": [
    "whiteboard",
    "flat-explainer",
    "paper-collage"
  ],
  "orientations": [
    "landscape"
  ],
  "slots": {
    "items": {
      "min": 2,
      "max": 2,
      "labelMax": 18,
      "textMax": 42
    }
  },
  "timing": {
    "actions": {
      "reveal": {
        "minSec": 0.3,
        "maxSec": 2
      },
      "draw": {
        "minSec": 0.3,
        "maxSec": 2
      },
      "highlight": {
        "minSec": 0.3,
        "maxSec": 2
      },
      "count": {
        "minSec": 0.3,
        "maxSec": 2
      }
    },
    "readingSec": 1.2,
    "titleHoldSec": 0.6,
    "sourceHoldSec": 0.6,
    "itemHoldSec": 0.3
  },
  "motion": {
    "recipeOwned": [
      "subject-and-live-text",
      "explicit-relationship",
      "complete-state-reading"
    ],
    "styleOwned": [
      "subject-medium",
      "entrance",
      "surface-treatment",
      "font-family",
      "palette"
    ],
    "continuousDrift": false
  },
  "qa": [
    "action-mid",
    "action-complete",
    "complete",
    "before-handoff"
  ],
  "sound": {
    "enabled": false,
    "events": []
  }
}
