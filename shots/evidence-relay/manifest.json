{
  "id": "evidence-relay",
  "version": "1.2.0",
  "status": "experimental",
  "registered": true,
  "visualKinds": [
    "statement"
  ],
  "purpose": "证据摘录与关键词同步更换",
  "inputModes": [
    "document-only",
    "document-with-assets"
  ],
  "requiredAssets": [],
  "styles": [
    "retro-zine",
    "signal",
    "scatterbrain",
    "archive-grid",
    "signal-noir",
    "studio-frame"
  ],
  "orientations": [
    "landscape"
  ],
  "slots": {
    "items": {
      "min": 2,
      "max": 4,
      "labelMax": 16,
      "textMax": 80
    },
    "keywords": {
      "min": 2,
      "max": 4,
      "labelMax": 6
    }
  },
  "timing": {
    "actions": {
      "enter": {
        "minSec": 0.2,
        "maxSec": 1.2
      },
      "reveal": {
        "minSec": 0.2,
        "maxSec": 1.2
      }
    },
    "readingSec": 0.8,
    "titleHoldSec": 0.6,
    "sourceHoldSec": 0.3,
    "itemHoldSec": 0.6
  },
  "motion": {
    "recipeOwned": [
      "evidence-relay",
      "recipe-specific-curves",
      "bounded-stage-order",
      "composition",
      "light-dark-stage",
      "material",
      "spatial-depth"
    ],
    "styleOwned": [
      "color-family",
      "font-family",
      "caption-color",
      "safe-area"
    ],
    "continuousDrift": false
  },
  "qa": [
    "action-mid",
    "action-complete",
    "complete",
    "before-handoff"
  ],
  "sound": {
    "enabled": false,
    "events": [
      "title-settled",
      "item-entered"
    ]
  }
}
