{
  "id": "word-roll",
  "version": "1.1.0",
  "status": "experimental",
  "registered": true,
  "visualKinds": [
    "statement"
  ],
  "purpose": "固定句干下轮换对象",
  "inputModes": [
    "document-only",
    "document-with-assets"
  ],
  "requiredAssets": [],
  "styles": [
    "retro-zine"
  ],
  "orientations": [
    "landscape"
  ],
  "slots": {
    "prefix": {
      "min": 1,
      "max": 1,
      "labelMax": 8
    },
    "items": {
      "min": 2,
      "max": 4,
      "labelMax": 6
    },
    "suffix": {
      "min": 0,
      "max": 1,
      "labelMax": 6
    }
  },
  "timing": {
    "actions": {
      "enter": {
        "minSec": 0.2,
        "maxSec": 1.2
      },
      "reveal": {
        "minSec": 0.2,
        "maxSec": 1.2
      }
    },
    "readingSec": 0.8,
    "titleHoldSec": 0.6,
    "sourceHoldSec": 0.3,
    "itemHoldSec": 0.6
  },
  "motion": {
    "recipeOwned": [
      "word-roll",
      "recipe-specific-curves",
      "bounded-stage-order"
    ],
    "styleOwned": [
      "color",
      "font",
      "surface",
      "entrance-offset"
    ],
    "continuousDrift": false
  },
  "qa": [
    "action-mid",
    "action-complete",
    "complete",
    "before-handoff"
  ],
  "sound": {
    "enabled": false,
    "events": [
      "title-settled",
      "item-entered"
    ]
  }
}
