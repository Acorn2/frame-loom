{
  "id": "letterspace-materialize",
  "version": "1.2.0",
  "status": "experimental",
  "registered": true,
  "visualKinds": [
    "statement"
  ],
  "purpose": "有来源字标连续描画",
  "inputModes": [
    "document-only",
    "document-with-assets"
  ],
  "requiredAssets": [],
  "styles": [
    "retro-zine",
    "signal",
    "scatterbrain",
    "archive-grid",
    "signal-noir",
    "studio-frame"
  ],
  "orientations": [
    "landscape"
  ],
  "slots": {
    "title": {
      "min": 1,
      "max": 1,
      "labelMax": 8
    }
  },
  "timing": {
    "actions": {
      "enter": {
        "minSec": 0.2,
        "maxSec": 10
      },
      "reveal": {
        "minSec": 0.2,
        "maxSec": 10
      },
      "focus": {
        "minSec": 0.2,
        "maxSec": 10
      },
      "highlight": {
        "minSec": 0.2,
        "maxSec": 10
      },
      "draw": {
        "minSec": 0.2,
        "maxSec": 10
      },
      "count": {
        "minSec": 0.2,
        "maxSec": 10
      }
    },
    "readingSec": 1.2,
    "titleHoldSec": 0.6,
    "sourceHoldSec": 0.6,
    "itemHoldSec": 0.001
  },
  "motion": {
    "recipeOwned": [
      "letterspace-materialize",
      "bounded-explicit-phases",
      "neutral-material",
      "source-faithful-layout"
    ],
    "styleOwned": [
      "accent",
      "font-family",
      "caption-color",
      "safe-area"
    ],
    "continuousDrift": false
  },
  "qa": [
    "action-mid",
    "action-complete",
    "complete",
    "before-handoff"
  ],
  "sound": {
    "enabled": false,
    "events": [
      "item-settled",
      "focus-complete"
    ]
  }
}
