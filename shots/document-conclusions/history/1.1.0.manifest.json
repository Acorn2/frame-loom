{
  "id": "document-conclusions",
  "version": "1.1.0",
  "status": "experimental",
  "registered": true,
  "visualKinds": [
    "network"
  ],
  "purpose": "一段原文支持三条结论",
  "inputModes": [
    "document-only",
    "document-with-assets"
  ],
  "requiredAssets": [],
  "styles": [
    "retro-zine"
  ],
  "orientations": [
    "landscape"
  ],
  "slots": {
    "source": {
      "min": 1,
      "max": 1,
      "labelMax": 20,
      "textMax": 110
    },
    "items": {
      "min": 3,
      "max": 3,
      "labelMax": 16,
      "textMax": 40
    }
  },
  "timing": {
    "actions": {
      "enter": {
        "minSec": 0.2,
        "maxSec": 1.2
      },
      "reveal": {
        "minSec": 0.2,
        "maxSec": 1.2
      },
      "draw": {
        "minSec": 0.15,
        "maxSec": 0.8
      },
      "focus": {
        "minSec": 0.15,
        "maxSec": 1.2
      },
      "highlight": {
        "minSec": 0.15,
        "maxSec": 0.6
      },
      "count": {
        "minSec": 0.2,
        "maxSec": 1.2
      },
      "dock": {
        "minSec": 0.4,
        "maxSec": 0.9
      }
    },
    "readingSec": 0.8,
    "titleHoldSec": 0.6,
    "sourceHoldSec": 0.3,
    "itemHoldSec": 0.6
  },
  "motion": {
    "recipeOwned": [
      "document-conclusions",
      "recipe-specific-curves",
      "bounded-stage-order"
    ],
    "styleOwned": [
      "color",
      "font",
      "surface",
      "entrance-offset"
    ],
    "continuousDrift": false
  },
  "qa": [
    "action-mid",
    "action-complete",
    "complete",
    "before-handoff"
  ],
  "sound": {
    "enabled": false,
    "events": [
      "title-settled",
      "item-entered"
    ]
  }
}
