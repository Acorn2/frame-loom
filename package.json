{
  "name": "frame-loom",
  "version": "0.5.0",
  "private": false,
  "description": "An open-source Agent Skill for turning structured documents into style-driven, reviewable videos.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "build": "remotion bundle src/index.ts --out-dir dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:storyboard": "vitest run tests/storyboard-validator.test.ts",
    "test:styles": "vitest run tests/style-workflow.test.mjs",
    "generate:schemas": "node --import tsx/esm scripts/generate-schemas.mjs",
    "validate:styles": "node --import tsx/esm scripts/validate-styles.mjs",
    "validate:assets": "node --import tsx/esm scripts/validate-assets.mjs",
    "list:styles": "node scripts/list-styles.mjs",
    "preview:styles": "node scripts/preview-styles.mjs",
    "init:project": "node scripts/init-project.mjs",
    "validate:storyboard": "node --import tsx/esm scripts/validate-storyboard.mjs",
    "render:storyboard": "node --import tsx/esm scripts/render-storyboard.mjs",
    "inspect:output": "node scripts/inspect-output.mjs",
    "inspect:audio": "node --import tsx/esm scripts/inspect-audio.mjs",
    "test:audio-pilot": "node --import tsx/esm scripts/test-audio-pilot.mjs",
    "test:visual-regression": "node --import tsx/esm scripts/test-visual-regression.mjs",
    "check:safe-area": "node scripts/check-safe-area.mjs",
    "extract:review-frames": "node scripts/extract-review-frames.mjs",
    "qa:storyboard": "node --import tsx/esm scripts/qa-storyboard.mjs"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.522",
    "@remotion/cli": "4.0.522",
    "@remotion/renderer": "4.0.522",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.522",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "22.15.21",
    "@types/react": "18.3.20",
    "@types/react-dom": "18.3.7",
    "eslint": "9.39.4",
    "tsx": "4.22.4",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
